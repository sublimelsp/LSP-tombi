{
  "contributions": {
    "settings": [
      {
        "file_patterns": [
          "/LSP-tombi.sublime-settings"
        ],
        "schema": {
          "$id": "sublime://settings/LSP-tombi",
          "allOf": [
            {
              "$ref": "sublime://settings/LSP-plugin-base"
            },
            {
              "$ref": "sublime://settings/LSP-tombi#/definitions/PluginConfig"
            }
          ],
          "definitions": {
            "PluginConfig": {
              "properties": {
                "settings": {
                  "additionalProperties": false,
                  "properties": {
                    "tombi": {
                      "$ref": "https://www.schemastore.org/tombi.json",
                      "markdownDescription": "Editor-level Tombi config. Uses the same keys as `tombi.toml`."
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "file_patterns": [
          "/*.sublime-project"
        ],
        "schema": {
          "properties": {
            "settings": {
              "properties": {
                "LSP": {
                  "properties": {
                    "LSP-tombi": {
                      "$ref": "sublime://settings/LSP-tombi#/definitions/PluginConfig"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
